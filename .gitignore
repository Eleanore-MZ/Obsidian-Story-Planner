# Test vault: build output and per-device Obsidian state
# Obsidian rewrites its own settings files when the vault is opened, so only
# the list of enabled plugins is kept in the repository.
test-vault/.obsidian/*
!test-vault/.obsidian/community-plugins.json
test-vault/.trash/
